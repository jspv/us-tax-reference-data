        },
        "salt_cap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cap",
            "cite",
            "indexing"
          ],
          "properties": {
            "cap": {
              "$ref": "#/$defs/by_status"
            },
            "phase_down": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "threshold",
                "rate",
                "floor",
                "measure"
