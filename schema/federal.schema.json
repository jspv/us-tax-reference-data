{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tax-reference-data/schema/federal.schema.json",
  "title": "Federal figures for one tax year",
  "description": "The federal tax, Medicare, payroll and retirement-account figures a retirement projection uses, for one tax year. Every amount and rate is a string holding a decimal number. Every group carries a cite naming the publication, PDF page and line or code section, and an indexing block saying how the figure changes in later years. Figures are as printed; nothing is computed here except where the publication prints a figure only in words.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layer",
    "jurisdiction",
    "tax_year",
    "income_tax",
    "medicare",
    "payroll",
    "retirement_accounts",
    "rmd"
  ],
  "properties": {
    "layer": {
      "const": "federal"
    },
    "jurisdiction": {
      "const": "US"
    },
    "tax_year": {
      "type": "integer"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "income_tax": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brackets",
        "standard_deduction",
        "additional_standard_deduction",
        "capital_gains",
        "net_investment_income_tax",
        "additional_medicare_tax",
        "social_security_benefits"
      ],
      "properties": {
        "brackets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schedules",
            "cite",
            "indexing"
          ],
          "properties": {
            "schedules": {
              "$ref": "#/$defs/brackets_by_status"
            },
            "cite": {
              "$ref": "#/$defs/cite"
            },
            "indexing": {
              "$ref": "#/$defs/indexing_rules"
            },
            "notes": {
              "type": "string"
            },
            "derivations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/derivation"
              }
            }
          },
          "description": "Ordinary income tax rate schedules (26 U.S.C. 1)."
        },
        "standard_deduction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "cite",
            "indexing"
          ],
          "properties": {
            "amount": {
              "$ref": "#/$defs/by_status"
            },
            "cite": {
              "$ref": "#/$defs/cite"
            },
            "indexing": {
              "$ref": "#/$defs/indexing_rules"
            },
            "notes": {
              "type": "string"
            },
            "derivations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/derivation"
              }
            }
          },
          "description": "Basic standard deduction (26 U.S.C. 63(c)(2))."
        },
        "additional_standard_deduction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "married",
            "unmarried",
            "cite",
            "indexing"
          ],
          "properties": {
            "married": {
              "$ref": "#/$defs/amount"
            },
            "unmarried": {
              "$ref": "#/$defs/amount"
            },
            "conditions": {
              "type": "string"
            },
            "cite": {
              "$ref": "#/$defs/cite"
            },
            "indexing": {
              "$ref": "#/$defs/indexing_rules"
            },
            "notes": {
              "type": "string"
            },
            "derivations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/derivation"
              }
            }
          },
          "description": "Additional standard deduction per condition (age 65 or older, blind) per person (26 U.S.C. 63(f)). married: married filing jointly or separately, or qualifying surviving spouse; unmarried: single or head of household."
        },
        "senior_deduction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount_per_person",
            "minimum_age",
            "phase_out",
            "cite",
            "indexing"
          ],
          "properties": {
            "amount_per_person": {
              "$ref": "#/$defs/amount"
            },
            "minimum_age": {
              "type": "integer"
            },
            "phase_out": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "threshold",
                "rate",
                "measure"
              ],
              "properties": {
                "threshold": {
                  "$ref": "#/$defs/by_status"
                },
                "rate": {
                  "$ref": "#/$defs/amount"
                },
                "measure": {
                  "type": "string",
                  "description": "The income measure, in the statute's words (modified adjusted gross income)."
                }
              }
            },
            "not_allowed_for": {
              "type": "array",
              "items": {
                "enum": [
                  "married_separate"
                ]
              }
            },
            "conditions": {
              "type": "string",
              "description": "Other conditions in words (valid SSN, joint return for married persons)."
            },
            "cite": {
              "$ref": "#/$defs/cite"
            },
            "indexing": {
              "$ref": "#/$defs/indexing_rules"
            },
            "notes": {
              "type": "string"
            },
            "derivations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/derivation"
              }
            }
          },
          "description": "Deduction for seniors added by P.L. 119-21 for 2025 through 2028: an amount per qualifying person, reduced by rate x the measure over the threshold, not below 0."
        },
        "capital_gains": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schedules",
            "cite",
            "indexing"
          ],
          "properties": {
            "schedules": {
              "$ref": "#/$defs/brackets_by_status"
            },
            "other_rates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "what",
                  "rate"
                ],
                "properties": {
                  "what": {
                    "type": "string"
                  },
                  "rate": {
                    "$ref": "#/$defs/amount"
                  }
                }
              }
            },
            "cite": {
              "$ref": "#/$defs/cite"
            },
            "indexing": {
              "$ref": "#/$defs/indexing_rules"
            },
            "notes": {
              "type": "string"
            },
            "derivations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/derivation"
              }
            }
          },
          "description": "Rates on qualified dividends and net capital gain (26 U.S.C. 1(h)): each band's start is a taxable income level, as the Qualified Dividends and Capital Gain Tax Worksheet applies it. other_rates: maximum rates on unrecaptured section 1250 gain and collectibles."
        },
        "net_investment_income_tax": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rate",
            "threshold",
            "measure",
            "cite",
            "indexing"
          ],
          "properties": {
            "rate": {
              "$ref": "#/$defs/amount"
            },
            "threshold": {
              "$ref": "#/$defs/by_status"
            },
            "measure": {
              "type": "string"
            },
            "cite": {
              "$ref": "#/$defs/cite"
            },
            "indexing": {
              "$ref": "#/$defs/indexing_rules"
            },
            "notes": {
              "type": "string"
            },
            "derivations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/derivation"
              }
            }
          },
          "description": "26 U.S.C. 1411: rate x the lesser of net investment income and the measure over the threshold."
        },
        "additional_medicare_tax": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rate",
            "threshold",
            "cite",
            "indexing"
          ],
          "properties": {
            "rate": {
              "$ref": "#/$defs/amount"
            },
            "threshold": {
              "$ref": "#/$defs/by_status"
            },
            "cite": {
              "$ref": "#/$defs/cite"
            },
            "indexing": {
              "$ref": "#/$defs/indexing_rules"
            },
            "notes": {
              "type": "string"
            },
            "derivations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/derivation"
              }
            }
          },
          "description": "26 U.S.C. 3101(b)(2): rate on wages and self-employment income over the threshold."
        },
        "social_security_benefits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_amount",
            "adjusted_base_amount",
            "first_rate",
            "second_rate",
            "measure",
            "cite",
            "indexing"
          ],
          "properties": {
            "base_amount": {
              "$ref": "#/$defs/by_status"
            },
            "adjusted_base_amount": {
              "$ref": "#/$defs/by_status"
            },
            "first_rate": {
              "$ref": "#/$defs/amount"
            },
            "second_rate": {
              "$ref": "#/$defs/amount"
            },
            "measure": {
              "type": "string",
              "description": "The income compared with the base amounts, in the statute's words (modified adjusted gross income plus half the benefits)."
            },
            "married_separate_lived_with_spouse": {
              "type": "string",
              "description": "What applies to a married person filing separately who lived with the spouse at any time in the year."
            },
            "cite": {
              "$ref": "#/$defs/cite"
            },
            "indexing": {
              "$ref": "#/$defs/indexing_rules"
            },
            "notes": {
              "type": "string"
            },
            "derivations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/derivation"
              }
            }
          },
