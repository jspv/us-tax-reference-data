            }
          },
          "description": "HSA contribution limits (26 U.S.C. 223(b))."
        }
      }
    },
    "rmd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_age",
        "uniform_lifetime_table",
        "single_life_table"
      ],
      "properties": {
        "start_age": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by_birth_year",
            "cite",
            "indexing"
          ],
          "properties": {
            "by_birth_year": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "age"
                ],
                "properties": {
                  "born_from": {
                    "type": "integer"
                  },
                  "born_through": {
                    "type": "integer"
                  },
                  "age": {
                    "type": "integer"
                  }
                }
              }
            },
            "cite": {
              "$ref": "#/$defs/cite"
            },
            "indexing": {
              "$ref": "#/$defs/indexing_rules"
            },
            "notes": {
              "type": "string"
            },
            "derivations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/derivation"
              }
            }
          },
          "description": "Required beginning age (26 U.S.C. 401(a)(9)(C)) by year of birth."
        },
        "uniform_lifetime_table": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rows",
            "cite",
            "indexing"
          ],
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "age",
                  "divisor"
                ],
                "properties": {
                  "age": {
                    "type": "integer"
                  },
                  "divisor": {
                    "$ref": "#/$defs/amount"
                  }
                }
              }
            },
            "cite": {
              "$ref": "#/$defs/cite"
            },
            "indexing": {
              "$ref": "#/$defs/indexing_rules"
            },
            "notes": {
              "type": "string"
            },
            "derivations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/derivation"
              }
            }
          },
          "description": "Distribution periods for owners (26 CFR 1.401(a)(9)-9(c)); the last row covers that age and older."
        },
        "single_life_table": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rows",
            "cite",
            "indexing"
          ],
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "age",
                  "divisor"
                ],
                "properties": {
                  "age": {
                    "type": "integer"
                  },
                  "divisor": {
                    "$ref": "#/$defs/amount"
                  }
                }
              }
            },
            "cite": {
              "$ref": "#/$defs/cite"
            },
            "indexing": {
              "$ref": "#/$defs/indexing_rules"
            },
            "notes": {
              "type": "string"
            },
            "derivations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/derivation"
              }
            }
          },
          "description": "Single Life Table (26 CFR 1.401(a)(9)-9(b)), used by beneficiaries."
        }
      }
    }
  },
  "$defs": {
    "amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "cite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication",
        "section",
        "url",
        "accessed"
      ],
      "properties": {
        "publication": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1,
          "description": "PDF page and the line, worksheet or code section; never just the title."
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "accessed": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "also": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "section"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "section": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": "Further documents that print some of this group's figures (a table split across two notices). The validator looks for each figure in the cited document and these."
        }
      }
    },
    "by_status": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "all": {
          "$ref": "#/$defs/amount"
        },
        "single": {
          "$ref": "#/$defs/amount"
        },
        "married_joint": {
          "$ref": "#/$defs/amount"
        },
        "married_separate": {
          "$ref": "#/$defs/amount"
        },
        "head_of_household": {
          "$ref": "#/$defs/amount"
        },
        "qualifying_surviving_spouse": {
          "$ref": "#/$defs/amount"
        }
      },
      "description": "An amount per federal filing status; 'all' when one amount applies to every status. A qualifying surviving spouse uses married_joint unless qualifying_surviving_spouse is given."
    },
    "bracket_list": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rate",
          "start"
        ],
        "properties": {
          "rate": {
            "$ref": "#/$defs/amount"
          },
          "start": {
            "$ref": "#/$defs/amount"
          },
          "base": {
            "$ref": "#/$defs/amount",
            "description": "Printed tax on income up to this band's start. When present it replaces the sum of the lower bands: tax on income above start is base + rate x (income - start). Income exactly at start stays in the band below. Used where a state's table steps up at a threshold (Ohio)."
          }
        }
      }
    },
    "brackets_by_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "single",
        "married_joint",
        "married_separate",
        "head_of_household"
      ],
      "properties": {
        "single": {
          "$ref": "#/$defs/bracket_list"
        },
        "married_joint": {
          "$ref": "#/$defs/bracket_list"
        },
        "married_separate": {
          "$ref": "#/$defs/bracket_list"
        },
        "head_of_household": {
          "$ref": "#/$defs/bracket_list"
        }
      },
      "description": "Each band: rate applies to income from start up to the next band's start. A qualifying surviving spouse uses married_joint."
    },
    "indexing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "cite"
      ],
      "properties": {
        "method": {
          "enum": [
            "fixed",
            "inflation",
            "wage_index",
            "scheduled",
            "set_yearly"
          ],
          "description": "fixed: the amount is written in the statute and does not change. inflation: adjusted each year by a price index (index, base_period, rounding). wage_index: adjusted by the national average wage index (Social Security wage base). scheduled: the statute prints each year's amount or a fixed yearly step (schedule). set_yearly: an agency sets it each year with no formula a projection can repeat (Medicare Part B premium)."
        },
        "index": {
          "enum": [
            "C-CPI-U",
            "CPI-U",
            "average_wage_index"
          ],
          "description": "C-CPI-U: chained CPI for all urban consumers (26 U.S.C. 1(f)(6)). CPI-U: CPI for all urban consumers."
        },
        "base_period": {
          "type": "string",
          "description": "As the statute states it, e.g. 'calendar year 2016' or 'the 12 months ending August 31, 2024'."
        },
        "rounding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "multiple",
            "direction"
          ],
          "properties": {
            "multiple": {
              "$ref": "#/$defs/amount"
            },
            "direction": {
              "enum": [
                "down",
                "nearest",
                "up"
              ]
            },
            "notes": {
              "type": "string"
            },
            "multiple_by_status": {
              "$ref": "#/$defs/by_status"
            }
          },
          "description": "Round the adjusted amount to a multiple of this: down (the statute says 'next lowest multiple'), nearest, or up. multiple_by_status overrides the multiple for the statuses it names (some figures for married filing separately round to half the unit)."
        },
        "schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "amount"
            ],
            "properties": {
              "year": {
                "type": "integer"
              },
              "amount": {
                "$ref": "#/$defs/by_status"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "applies_through": {
          "type": "integer",
          "description": "Last tax year this rule applies; after it, 'then' says what replaces it."
        },
        "then": {
          "type": "string",
          "description": "What applies after applies_through, in words, with the amount if the statute prints it."
        },
        "cite": {
          "$ref": "#/$defs/cite"
        },
        "notes": {
          "type": "string"
        },
        "indexed_from": {
          "type": "integer",
          "description": "First year the figure is indexed; before it the figure stays as printed (the IRMAA top limits are not indexed before 2028)."
        },
        "never_decreases": {
          "type": "boolean",
          "description": "True when the statute says the adjusted figure may not fall below the prior year's (the Social Security wage base)."
        },
        "applies_to": {
          "type": "string",
          "description": "When the group's figures don't all index the same way: which figures this indexing covers. Derived figures (derivations) are never indexed themselves."
        }
      },
      "description": "How this figure changes in later years, cited to the statute that says so. A projection uses this to carry the figure forward."
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "rule",
        "from",
        "cite"
      ],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^[a-z_]+(\\[[0-9]+\\])?(\\.[a-z_]+(\\[[0-9]+\\])?)*$",
          "description": "The derived figure, as a path inside this group: 'schedules.single[1].start', 'amount.married_joint', 'tiers[4].over.married_joint'."
        },
        "rule": {
          "enum": [
            "times",
            "minus"
          ],
          "description": "times: target = from x factor. minus: target = from - subtract."
        },
        "from": {
          "type": "string",
          "pattern": "^[a-z_]+(\\[[0-9]+\\])?(\\.[a-z_]+(\\[[0-9]+\\])?)*$",
          "description": "The figure it is set from, a path inside this group. That figure must be indexed on its own (not itself a target)."
        },
        "factor": {
          "$ref": "#/$defs/amount"
        },
        "subtract": {
          "type": "string",
          "pattern": "^[a-z_]+(\\[[0-9]+\\])?(\\.[a-z_]+(\\[[0-9]+\\])?)*$"
        },
        "cite": {
          "$ref": "#/$defs/cite"
        },
        "notes": {
          "type": "string"
        }
      },
      "description": "A figure the statute sets from another figure of the same year, after that figure's own indexing and rounding; the derived figure is not indexed or rounded itself. Example: the joint standard deduction is 2 times the single one (26 U.S.C. 63(c)(2)(A)). In a later year a projection indexes the source and re-derives the target. The validator re-does the arithmetic exactly."
    },
    "indexing_rules": {
      "oneOf": [
        {
          "$ref": "#/$defs/indexing"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/indexing"
          }
        }
      ]
    }
  }
}
