    "medicare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_b",
        "irmaa"
      ],
      "properties": {
        "part_b": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "standard_monthly_premium",
            "cite",
            "indexing"
