                },
                "rate": {
                  "$ref": "#/$defs/amount"
                },
                "floor": {
                  "$ref": "#/$defs/by_status"
                },
                "measure": {
                  "type": "string"
                }
              }
            },
            "cite": {
              "$ref": "#/$defs/cite"
            },
            "indexing": {
              "$ref": "#/$defs/indexing_rules"
            },
            "notes": {
              "type": "string"
            },
            "derivations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/derivation"
              }
            }
          },
          "description": "Limit on the itemized deduction for state and local taxes (26 U.S.C. 164(b)(6)-(7)): the cap is reduced by rate x the measure over the threshold, not below the floor."
        }
      }
