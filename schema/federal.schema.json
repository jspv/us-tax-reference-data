              }
            }
          },
          "description": "Medicare Part B standard premium and deductible for the calendar year."
        },
        "irmaa": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lookback_years",
            "measure",
            "tiers",
            "cite",
            "indexing"
          ],
          "properties": {
            "lookback_years": {
              "type": "integer",
              "description": "The premium year uses the tax return from this many years earlier."
            },
            "measure": {
              "type": "string"
            },
            "tiers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "over"
                ],
                "properties": {
                  "over": {
                    "$ref": "#/$defs/by_status"
                  },
                  "up_to": {
                    "$ref": "#/$defs/by_status"
                  },
                  "part_b_monthly_total": {
                    "$ref": "#/$defs/amount"
                  },
                  "part_b_monthly_adjustment": {
                    "$ref": "#/$defs/amount"
                  },
                  "part_d_monthly_adjustment": {
                    "$ref": "#/$defs/amount"
                  },
                  "notes": {
                    "type": "string"
                  },
                  "applies_when": {
                    "enum": [
                      "over",
                      "at_or_over"
                    ],
                    "description": "over (default): the tier applies when the measure is more than `over`. at_or_over: when it is equal to or more (CMS prints the top tier as 'greater than or equal to')."
                  }
                },
                "description": "One income tier. over: the tier applies when the measure is more than this (by status: single covers single, head of household, qualifying surviving spouse and married filing separately who lived apart; married_separate is the separate-but-lived-together table); up_to: the tier's upper limit, inclusive, as printed."
              },
              "description": "Tiers from lowest to highest. A household is in the highest tier whose `over` test its measure passes (more than `over`, or equal to or more for applies_when at_or_over); `up_to` is the upper limit as printed and is for reading only, so a tier just below an at_or_over tier ends below that tier's `over`."
            },
            "cite": {
              "$ref": "#/$defs/cite"
            },
            "indexing": {
              "$ref": "#/$defs/indexing_rules"
            },
            "notes": {
              "type": "string"
            },
            "derivations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/derivation"
              }
            }
          },
          "description": "Income-related monthly adjustment amounts for Parts B and D (42 U.S.C. 1395r(i), 1395w-113(a)(7))."
        }
      }
    },
