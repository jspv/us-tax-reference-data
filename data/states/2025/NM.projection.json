 "approximations": [
  {
   "what": "Starts from federal taxable income although the record's base is federal AGI, because New Mexico subtracts the federal standard or itemized deduction (PIT-1 line 12, Form 1040 line 12) and prints no amount of its own. Starting from AGI with no deduction would overstate tax by the whole federal deduction. Form PIT-1 confirms it: line 12 is the only federal deduction it takes, and it has no line for anything the federal return subtracts after line 12, so a consumer's federal taxable income is too low by that amount.",
   "direction": "understates_tax",
   "size": "The amount the federal return subtracts after line 12, at the New Mexico rate."
  },
  {
   "what": "The add-back of state and local taxes for itemizers (PIT-1 line 10 and worksheet) is not applied.",
   "direction": "understates_tax",
   "size": "Itemizers only; at most itemized deductions less the federal standard deduction."
  },
  {
   "what": "Over 100,000 the printed section is base plus rate, and each base is the table's last row (midpoint 99,950), not the tax at 100,000. A bracket schedule cannot hold that step down, so the schedule gives more than the printed section at every income over 100,000.",
   "direction": "overstates_tax",
   "size": "2 single, joint, head of household; 2.50 separate. Example: single at 150,000 is 6,808 by the schedule, 6,806 as printed."
  },
  {
   "what": "The cap of 2,500 applies to all gains; the booklet's net capital gains exclude short-term gains.",
   "direction": "understates_tax",
   "size": "At most 2,500 of income, only for a household with no long-term gains."
  },
  {
   "what": "Interest on U.S. obligations is taxed (the projection cannot tell it from other interest).",
   "direction": "overstates_tax"
  },
  {
   "what": "A projection that cannot tell New Mexico bonds from other states' bonds treats all tax-exempt interest as other-state and adds it back.",
   "direction": "overstates_tax"
  },
  {
   "what": "The age 100 exemption offsets the person's own income; a married centenarian exempts half of all community income and all separate income, and New Mexico is a community property state.",
   "direction": "either"
  }
 ],
