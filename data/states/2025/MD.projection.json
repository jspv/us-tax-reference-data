  "approximations": [
    {
      "what": "The additional 2% tax is charged on all net capital gain (short- and long-term, Form 502 Line 1c) when federal AGI is over 350,000. The booklet excludes 'net capital gain from the sale of certain assets' and leaves which assets to Form 502CG and Technical Bulletin 58, neither in the sources, so no exclusion is applied; nor does the booklet say whether short-term gains are part of 'net capital gain income'.",
      "direction": "overstates_tax",
      "size": "2% of any excluded gain (or of a short-term gain, if Maryland leaves it out) in a year federal AGI is over 350,000: a 300,000 gain that Form 502CG excludes is overstated by 6,000; nothing when AGI is 350,000 or less."
    },
    {
      "what": "Roth conversions are not in the pension exclusion's covers: the booklet excludes IRAs but does not name conversions (covers_unclear). A conversion from a traditional IRA is IRA income and does not qualify; only a conversion out of a qualified employer plan could, if at all.",
      "direction": "overstates_tax",
      "size": "At most the state rate (up to 6.5%) times the unused exclusion room, in a conversion year, for a person 65 or older."
    },
    {
      "what": "Only the standard deduction is applied; a household that itemizes federally may itemize in Maryland (less state and local income taxes, reduced by 7.5% of federal AGI over 200,000).",
      "direction": "overstates_tax",
      "size": "The state rate times itemized deductions above 3,350 single or 6,700 joint."
    },
    {
      "what": "The personal exemption is applied per filer only; dependents' exemptions are not counted.",
      "direction": "overstates_tax",
      "size": "Up to 4.75% of 3,200 = 152 a year per dependent (6,400 for one 65 or over) at incomes where the full exemption is allowed."
    },
    {
      "what": "Interest on U.S. Treasury obligations is taxed (the projection cannot tell it from other interest).",
      "direction": "overstates_tax",
      "size": "The state rate times the Treasury interest, plus any exemption the code hh adjustment would restore."
    },
    {
      "what": "The two-income married couple subtraction is not applied.",
      "direction": "overstates_tax",
      "size": "At most 1,200 x 4.75% = 57 a year for a joint return with two earners."
    },
    {
      "what": "The centenarian subtraction applies to all income of the person aged 100, but the projection splits joint investment income between spouses as it holds it, not as the booklet would attribute it.",
      "direction": "either",
      "size": "Only households with a person 100 or older; at most 6.5% of 100,000 = 6,500 a year."
    },
    {
      "what": "The pension exclusion's covers include every employer-plan distribution; the booklet qualifies only plans under IRC 401(a), 403 and 457(b), which the Form 502R chart says include 401(k), 403(b), governmental 457(b), Thrift Savings and SIMPLE 401(k). A 457(f) plan does not qualify.",
      "direction": "understates_tax",
      "size": "Only for an ineligible 457(f) plan; up to 6.5% of the exclusion room."
    }
  ],
