  "approximations": [
    {
      "what": "The federal income tax deduction is not applied (not_modelled).",
      "direction": "overstates_tax",
      "size": "Up to 5% of the year's federal income tax: a household paying 20,000 federal tax is overstated by up to 1,000 a year in Alabama tax. The largest approximation for Alabama."
    },
    {
      "what": "Alabama starts from its own total income and Alabama AGI (Form 40 line 10); the projection starts from federal AGI and removes the exempt income through the reliefs and Social Security treatment.",
      "direction": "either",
      "size": "Usually small for a retiree; for a State of Alabama employee, retirement contributions deferred federally are taxed by Alabama (understates), and Alabama IRA adjustments differ."
    },
    {
      "what": "The brackets are derived from the tax table. Under 100,000 the table taxes each 100-dollar row at its midpoint, rounded; above 100,000 the printed worksheet ((income - 100,000) x .05 + 4,958, or + 4,918 joint) is 2 dollars below the derived brackets.",
      "direction": "overstates_tax",
      "size": "At most 2 dollars a year above 100,000 of taxable income; under 1 dollar either way below it."
    },
    {
      "what": "Every private pension and every other state's government pension is treated as paid by a plan that qualifies as a defined benefit plan under IRC 414(j), and every Alabama or federal government pension as exempt; the booklet exempts only the listed systems and qualifying 414(j) plans and leaves qualification to the plan administrator.",
      "direction": "understates_tax",
      "size": "5% of a pension whose plan does not qualify: 1,500 a year on a 30,000 pension."
    },
    {
      "what": "The standard deduction is always taken; Alabama itemized deductions (Schedule A) are not modelled.",
      "direction": "overstates_tax",
      "size": "5% of the amount by which itemized deductions exceed the standard deduction, for an itemizer."
    },
    {
      "what": "IRA and employer-plan distributions use the federal taxable amount; Alabama basis can be larger (IRA, SEP and Keogh contributions before 1982, 401(k)(2) and 403(b) contributions before 1985 count as Alabama basis).",
      "direction": "overstates_tax",
      "size": "5% of the extra Alabama basis recovered; usually none for contributions made after 1985."
    },
    {
      "what": "Interest on U.S. obligations is taxed (the projection cannot tell it from other interest).",
      "direction": "overstates_tax",
      "size": "5% of the Treasury interest."
    },
    {
      "what": "A projection that cannot tell Alabama bonds from other states' bonds treats all tax-exempt interest as other-state and taxes it.",
      "direction": "overstates_tax",
      "size": "5% of the interest from Alabama obligations."
    }
  ],
